{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "explore.theverityai.xyz"
        }
      ],
      "destination": "https://verity.plotarmour.in/explore/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "explore.theverityai.xyz"
        }
      ],
      "destination": "https://verity.plotarmour.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "theverityai.xyz"
        }
      ],
      "destination": "https://verity.plotarmour.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.theverityai.xyz"
        }
      ],
      "destination": "https://verity.plotarmour.in/:path*",
      "permanent": true
    }
  ]
}
