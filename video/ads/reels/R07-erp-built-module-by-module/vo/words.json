{
 "duration": 40.824,
 "segments": [
  {
   "start": 0.0,
   "end": 2.3,
   "text": "Aapke business ke liye ERP dhoond rahe hain."
  },
  {
   "start": 2.44,
   "end": 7.06,
   "text": "Most ERP ek fixed system pe chalte hain, but har business ka workflow different hota hain."
  },
  {
   "start": 7.22,
   "end": 13.42,
   "text": "Verity mein IIMs and IITs se selected humare product managers pehle aapke business ko detail mein samajhte hain."
  },
  {
   "start": 13.62,
   "end": 22.9,
   "text": "Workflows, teams, approvals, reporting aur actual requirements ko map karke, system ko module by module, aapke business ke liye from scratch build karte hain."
  },
  {
   "start": 23.12,
   "end": 24.02,
   "text": "Pehle requirement."
  },
  {
   "start": 24.64,
   "end": 25.88,
   "text": "Phir proposed system."
  },
  {
   "start": 26.28,
   "end": 28.14,
   "text": "Aapki approval ke baad implementation."
  },
  {
   "start": 28.14,
   "end": 31.92,
   "text": "5,000 value worth Business Analysis Blueprint, Diwali tak free."
  },
  {
   "start": 32.42,
   "end": 38.36,
   "text": "Agar aap software upgrade, replace, ya implement karne ka plan bana rahe hain, Learn More par click kijiye and we will give you a call."
  },
  {
   "start": 38.76,
   "end": 40.7,
   "text": "Tell us about your business. Get your business blueprint."
  }
 ],
